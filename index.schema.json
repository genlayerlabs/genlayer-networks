{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "genlayer-networks deployment index",
  "type": "object",
  "required": ["repository", "generatedAt", "commit", "deployments"],
  "properties": {
    "repository": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "commit": { "type": "string", "description": "genlayer-networks commit the index was built from" },
    "deployments": {
      "type": "array",
      "description": "Newest folder first (ordered by the commit that added the folder's deployment book)",
      "items": {
        "type": "object",
        "required": ["name", "label", "path", "book", "network", "set", "addressManager", "createdAt", "updatedAt"],
        "properties": {
          "name": { "type": "string", "description": "Folder name, the stable identifier" },
          "label": { "type": "string", "description": "Human label derived from the folder name" },
          "path": { "type": "string" },
          "book": { "type": "string", "description": "Path of testnet_deployments.json inside the repository" },
          "abi": { "type": ["string", "null"], "description": "Path of the abi/ folder, when the artifacts were kept" },
          "readme": { "type": ["string", "null"] },
          "network": { "type": "string", "description": "Top-level key of the book, e.g. genlayerOrbitTestnet" },
          "set": { "type": "string", "description": "Deployment set key, e.g. deployment_bradbury_phase_2" },
          "addressManager": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
          "consensusCommit": { "type": ["string", "null"], "description": "Contents of the folder's COMMIT file (genlayer-consensus commit)" },
          "createdAt": { "type": ["string", "null"], "format": "date-time" },
          "updatedAt": { "type": ["string", "null"], "format": "date-time" }
        }
      }
    }
  }
}
